# Hostinger MySQL — hPanel → Databases → Remote MySQL hostname (srvXXXX.hstgr.io)
# URL-encode special characters in the password (@ → %40).
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
STORE_ID="wokora"

# Live site (GoDaddy domain). Local laptop only: http://localhost:3000
NEXTAUTH_URL="https://wokorafoods.com"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Authorized JavaScript origins:
#   https://wokorafoods.com
#   https://www.wokorafoods.com
# Authorized redirect URIs:
#   https://wokorafoods.com/api/auth/callback/google
#   https://www.wokorafoods.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Hostinger mailbox or Gmail App Password
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="hello@wokorafoods.com"
SMTP_PASS=""
SMTP_FROM="hello@wokorafoods.com"

# Created/updated on prisma db seed. Kitchen login uses this admin user.
KITCHEN_ADMIN_NAME="Wokora Kitchen"
KITCHEN_ADMIN_PHONE=""
KITCHEN_ADMIN_EMAIL=""
KITCHEN_ADMIN_PASSWORD=""

PRINT_MODE="kiosk"
PRINT_AGENT_URL="http://127.0.0.1:4100"
PRINT_AGENT_SECRET="replace-with-a-print-agent-secret"
PRINTER_IP=""
PRINTER_PORT="9100"

# Server-only payout. Never use NEXT_PUBLIC_ for bank or UPI destination.
UPI_PAYEE_NAME="Wokora Foods"
UPI_VPA=""
BANK_ACCOUNT_NUMBER=""
BANK_IFSC=""
BANK_NAME=""
BANK_BRANCH=""
BANK_HOLDER=""
BANK_MOBILE=""

# Razorpay. Key secret stays on the server. Never prefix it with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

WHATSAPP_NOTIFY="false"
# WhatsApp Cloud API — kitchen gets support queries on this Business number.
# Meta → WhatsApp → API Setup: Permanent token + Phone number ID.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
