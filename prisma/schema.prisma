generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Store {
  id        String     @id
  slug      String     @unique
  name      String
  createdAt DateTime   @default(now())
  users     User[]
  orders    Order[]
  carts     CartLine[]
  categories Category[]
  menuItems MenuItem[]
}

model User {
  id              String         @id @default(cuid())
  cognitoSub      String?        @unique
  storeId         String         @default("wokora")
  store           Store          @relation(fields: [storeId], references: [id])
  name            String
  phone           String
  email           String?        @unique
  passwordHash    String
  role            String         @default("customer")
  loyaltyPoints   Int            @default(0)
  phoneVerified   Boolean        @default(false)
  emailVerified   Boolean        @default(false)
  dietPreference  String         @default("all")
  themePreference String         @default("dark")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  orders          Order[]
  payments        Payment[]
  addresses       Address[]
  notifications   Notification[]
  cartLines       CartLine[]

  @@unique([storeId, phone])
  @@index([storeId])
  @@index([cognitoSub])
}

model Address {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  label   String
  line1   String
  city    String
  pincode String
}

model Category {
  id        String     @id @default(cuid())
  storeId   String     @default("wokora")
  store     Store      @relation(fields: [storeId], references: [id])
  name      String
  slug      String
  iconUrl   String?
  sortOrder Int        @default(0)
  items     MenuItem[]

  @@unique([storeId, slug])
  @@index([storeId])
}

model MenuItem {
  id          String      @id @default(cuid())
  storeId     String      @default("wokora")
  store       Store       @relation(fields: [storeId], references: [id])
  name        String
  slug        String
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  description String
  price       Float
  halfPrice            Float?
  fullPrice            Float?
  imageUrl             String
  customizationsJson   String?      @db.LongText
  isVeg                Boolean      @default(true)
  isAvailable          Boolean      @default(true)
  isFeatured           Boolean      @default(false)
  orderItems           OrderItem[]
  cartLines            CartLine[]

  @@unique([storeId, slug])
  @@index([storeId])
}

model CartLine {
  id             String   @id @default(cuid())
  storeId        String   @default("wokora")
  store          Store    @relation(fields: [storeId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  quantity       Int
  configKey      String   @default("default")
  customization  String   @default("")
  selections     String   @default("{}")
  unitPrice      Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, storeId, menuItemId, configKey])
  @@index([storeId, userId])
}

model Order {
  id             String      @id @default(cuid())
  storeId        String      @default("wokora")
  store          Store       @relation(fields: [storeId], references: [id])
  serialNumber   Int         @default(0)
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  tableNumber    String?
  type           String      @default("dine_in")
  status         String      @default("placed")
  paymentStatus  String      @default("pending")
  paymentMethod  String?
  etaMinutes     Int?
  etaSetAt       DateTime?
  subtotal       Float
  taxAmount      Float
  totalAmount    Float
  notes          String?
  printedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
  payments       Payment[]
  printJobs      PrintJob[]

  @@unique([storeId, serialNumber])
  @@index([userId])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, userId])
  @@index([storeId, createdAt])
}

model Payment {
  id            String    @id @default(cuid())
  storeId       String    @default("wokora")
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  method        String
  status        String
  amount        Float
  upiVpa        String    @default("")
  upiApp        String    @default("")
  txnRef        String    @default("")
  failureReason String    @default("")
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([orderId])
  @@index([userId, createdAt])
  @@index([storeId, status])
}

model Notification {
  id        String   @id @default(cuid())
  storeId   String   @default("wokora")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  orderId   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([storeId, userId])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id])
  quantity       Int
  priceAtOrder   Float
  customization  String   @default("")
}

model PrintJob {
  id        String    @id @default(cuid())
  storeId   String    @default("wokora")
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String    @default("pending")
  payload   String
  createdAt DateTime  @default(now())
  printedAt DateTime?

  @@index([storeId, status])
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model SupportTicket {
  id        String         @id @default(cuid())
  userId    String?
  name      String
  phone     String
  email     String?
  subject   String
  message   String
  status    String         @default("open")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  replies   SupportReply[]
}

model SupportReply {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorName String
  authorRole String
  message    String
  createdAt  DateTime      @default(now())
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  purpose   String   @default("signup")
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

model MediaFile {
  id        String   @id @default(cuid())
  mime      String   @default("image/jpeg")
  data      Bytes
  createdAt DateTime @default(now())
}

model CafeSettings {
  id      String @id @default("cafe")
  name    String @default("Wokora Foods")
  phone   String @default("+91 81782 06648")
  email   String @default("wokorafoods@gmail.com")
  address String @default("Shop No. 23, LGF, Siddharth Vihar, Opus Plot, Yojna, Ghaziabad, UP 201009")
  hours   String @default("11:00 AM – 11:00 PM")
  upiVpa  String @default("")
}
